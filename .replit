modules = ["python-3.12", "bash"]

[nix]
channel = "stable-25_05"
packages = ["freetype", "lcms2", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "openjpeg", "tcl", "tk", "zlib"]

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start bot"

[[workflows.workflow]]
name = "Start bot"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash start"

[workflows.workflow.metadata]
outputType = "console"
